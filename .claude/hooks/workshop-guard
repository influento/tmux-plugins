#!/usr/bin/env bash
# PreToolUse hook for Bash and the edit tools, copied into a project by
# guard. A change to a path of .claude/guarded waits for the user: the hook
# refuses it and tells the agent to ask in plain words, until the user
# approves (approved below). A change to a path of an Edit(...) rule in
# permissions.deny is refused. A shell command changes a path when it can
# write it or cds into a guarded directory: settings rules alone let a
# redirect such as `> tsconfig.json` through in auto mode (../../AGENTS.md,
# "Guarded files"). The hook judges each
# pipeline of the command alone: one that names the path passes when the
# part that first names it and every part after it are known reads (cat,
# grep, git diff, ...) and no redirect goes into the path, since a pipe
# carries data only forward. When a cd or a variable can carry the path from one
# pipeline into the next, the whole command must read, with no redirect
# into a file. A $( ) is judged as a command of its own, a heredoc's text as
# the input of its command. A path that a known checker gets as its config (CONFIG_FLAGS)
# is not counted: the checker only reads it. A command that builds the path
# at run time is not seen.
set -euo pipefail
exec python3 -c "$(cat <<'PY'
import json, os, re, shlex, sys

data = json.load(sys.stdin)
tool = data.get("tool_name", "Bash")
cmd = data.get("tool_input", {}).get("command", "")
root = os.path.abspath(os.environ.get("CLAUDE_PROJECT_DIR", "."))
try:
    with open(os.path.join(root, ".claude/settings.json")) as fh:
        perms = json.load(fh).get("permissions", {})
except (OSError, ValueError):
    perms = {}
try:
    with open(os.path.join(root, ".claude/guarded")) as fh:
        listed = [line.strip() for line in fh if line.strip()]
except OSError:
    listed = []

READ = {"cat", "head", "tail", "less", "wc", "ls", "grep", "rg", "diff", "cmp", "stat", "file",
        "tree", "jq", "realpath", "readlink", "basename", "dirname", "echo", "printf", "test",
        "[", "true", ":", "cd", "pwd", "cut", "tr", "nl", "uniq", "column", "od", "xxd",
        "md5sum", "sha256sum", "read", "mapfile", "readarray", "for", "select"}
GIT_READ = {"diff", "log", "show", "status", "blame", "grep", "ls-files", "ls-tree", "rev-parse",
            "cat-file", "merge-base", "describe", "shortlog", "check-ignore", "add", "commit"}
FIND_WRITE = {"-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprint0", "-fprintf", "-fls"}
# A checker reads the file that one of these flags names and never writes it.
# A new gate adds its own checkers here.
CONFIG_FLAGS = {
    "tsc": {"-p", "--project"},
    "vitest": {"-c", "--config"},
    "eslint": {"-c", "--config"},
    "ruff": {"--config"},
    "basedpyright": {"-p", "--project"},
    "pytest": {"-c", "--config-file"},
    "lint-imports": {"--config"},
    "golangci-lint": {"-c", "--config"},
}
# uv run's own flags that take a value, before the command it runs.
UV_RUN_VALUE = {"--with", "--with-editable", "--with-requirements", "--python", "-p", "--group", "--extra",
                "--package", "--directory", "--project", "--env-file", "--index", "--default-index"}
RUNNERS = {"npx", "bunx", "yarn"}
# The interpreters that run a script file named as their first word.
SCRIPT_RUNNERS = {"bash", "sh", "python", "python3"}
# uv run's flags that change nothing in what the interpreter runs.
UV_RUN_PLAIN = {"--locked", "--exact", "--frozen", "--offline", "--no-sync", "--quiet", "-q"}
# The builtins that change the shell's variables, functions, aliases, command
# hash, options or traps, or run text in it.
SHELL_STATE = {"source", ".", "eval", "export", "declare", "typeset", "local", "readonly", "unset",
               "hash", "alias", "unalias", "enable", "builtin", "set", "shopt", "read", "mapfile", "readarray",
               "getopts", "integer", "float", "autoload", "unfunction", "unhash", "disable", "setopt",
               "unsetopt", "emulate", "zmodload", "zparseopts", "vared", "rehash", "functions", "trap"}
# Shell words before a part's command: they run nothing.
KEYWORDS = {"if", "then", "elif", "else", "fi", "while", "until", "do", "done", "!", "{", "}", "time"}
# timeout's flags that take a value, before its duration and the command.
TIMEOUT_VALUE = {"-s", "--signal", "-k", "--kill-after"}
# The commands that bind a variable from their input.
READERS = {"read", "mapfile", "readarray"}
# The flag that gives each interpreter an inline script, and the calls in
# which that script only reads a path.
INLINE = {"node": {"-e", "-p", "--eval", "--print"}, "python3": {"-c"}, "python": {"-c"}}
READ_CALL = (r"(?:(?<![\w.$])require|\breadFileSync|(?<![\w.$])open)\(\s*(['\"`])[^'\"`\n]*?(?:{})[^'\"`\n]*\1"
             r"\s*(?:,\s*(['\"])(?:utf-?8|r|rb)\2\s*)?\)")
# A function definition, `name() {`, zsh's `a b () {`, or `function a b {`:
# the names it gives.
FUNC_DEF = re.compile(r"(?:^|[;&|\n{(]|\b(?:then|do|else))[ \t]*(?:function((?:[ \t]+[^\s(){};&|]+)+)"
                      r"|((?:[^\s(){};&|=$]+[ \t]+)*[^\s(){};&|=$]+)[ \t]*\([ \t]*\))")
# The names the hook trusts before a script.
TRUSTED = {"bash", "sh", "python", "python3", "uv", "timeout"}
# An assignment: its name, and its subscript if it sets an element.
ASSIGN = re.compile(r"^(\w+)(\[[^\]]*\])?\+?=")
# The variables of bash and zsh that change which program a name runs, or
# what runs first, beside those the environment holds.
LOOKUP = r"(?:PATH|path|commands|functions|aliases|galiases|saliases|options|fpath|FPATH|module_path" \
         r"|MODULE_PATH|dis_\w+|BASH_\w+|ENV|PYTHON\w*)"
# Shell text that sets one: a loop's variable, or an expansion that assigns
# (${PATH:=}, zsh's ${(P)name::=}).
SHELL_TEXT = re.compile(r"\b(?:for|select)[ \t]+" + LOOKUP + r"\b|\$\{[^}]*=")
HEREDOC = re.compile(r"<<(-?)[ \t]*(?:'(\w+)'|\"(\w+)\"|\\?(\w+))")

def split(words):
    # A part's leading keywords, assignments and timeout, and its command.
    i = 0
    while i < len(words):
        if words[i] in KEYWORDS or re.match(r"^\w+=", words[i]) or words[i] == "-p" and words[i - 1:i] == ["time"]:
            i += 1
        elif words[i] == "timeout":
            i += 1
            while i < len(words) and words[i].startswith("-"):
                i += 2 if words[i] in TIMEOUT_VALUE else 1
            i += 1
        else:
            break
    return words[:i], words[i:]

def reads(words):
    if not words:
        return True
    name, args = words[0], words[1:]
    if name in READ:
        return True
    if name == "sort":
        return not any(a.startswith(("-o", "--output")) for a in args)
    if name == "find":
        return not FIND_WRITE.intersection(args)
    if name == "sed":
        script = [a for a in args if not a.startswith("-")][:1]
        return "-n" in args and not any(a.startswith(("-i", "--in-place")) for a in args) \
            and bool(script) and re.fullmatch(r"[\d,$]+p", script[0]) is not None
    if name == "git":
        while args and args[0].startswith("-"):
            args = args[2:] if args[0] in ("-C", "-c") else args[1:]
        return bool(args) and args[0] in GIT_READ and not any(a.startswith("--output") for a in args)
    return False

def script_run(words):
    # Where the script word is when an interpreter runs a script file by its
    # plain name (`bash py-gate/scripts/gate.sh`, `uv run --locked python
    # py-gate/check.py`), else None. With any option the word after it may be
    # a script text (-ec, -c), an argument (-s, -) or a module (-m). npx,
    # yarn, bunx and pnpm exec resolve the project's own bins, which can be
    # any program by that name, and uv run's other flags can set its
    # environment (--env-file) or add packages (--with).
    i = 0
    if words[:2] == ["uv", "run"]:
        i = 2
        while i < len(words) and words[i] in UV_RUN_PLAIN:
            i += 1
    if i + 1 < len(words) and words[i] in SCRIPT_RUNNERS and not words[i + 1].startswith(("-", "+")):
        return i + 1
    return None

def changes_shell(part):
    # A part that changes the shell itself, and so which program a name runs
    # or what an interpreter reads first: a variable set alone that a
    # program or the shell can see (one the environment holds, one of
    # LOOKUP, an element of an array), or any variable set for the
    # interpreter; a
    # builtin that sets variables, aliases, the command hash or options, or
    # runs text in the shell. Any other program runs in a process of its own
    # and cannot change the shell. parse finds the rest in the shell's text:
    # a loop or an expansion that sets a variable (SHELL_TEXT), and function
    # definitions, whose () the parts lose.
    pre, command = split(part[0])
    words = pre + command[:1]
    sets = [m for w in words if (m := ASSIGN.match(w))]
    if command and not ASSIGN.match(command[0]):
        if sets and script_run(command) is not None:
            return True
        return command[0] in SHELL_STATE or (command[0] in ("printf", "print") and "-v" in command)
    return any(m.group(2) or m.group(1) in os.environ or re.fullmatch(LOOKUP, m.group(1)) for m in sets)

def unread(words, scripts):
    # The words of a command that can name a path it writes: all but the
    # value of a checker's config flag, and, when scripts, the script that
    # an interpreter runs.
    if scripts and (k := script_run(words)) is not None:
        return words[:k] + words[k + 1:]
    i = 0
    if words[:1] and words[0] in RUNNERS:
        i = 1
    elif words[:2] == ["pnpm", "exec"]:
        i = 2
    elif words[:2] == ["uv", "run"]:
        i = 2
        while i < len(words) and words[i].startswith("-"):
            i += 2 if words[i] in UV_RUN_VALUE else 1
    name = words[i] if i < len(words) else ""
    if name == "cp":
        return words[:i + 1] + cp_target(words[i + 1:])
    if name.startswith(("node_modules/.bin/", "./node_modules/.bin/")) or re.search(r"(^|/)\.venv/bin/[^/]+$", name):
        name = os.path.basename(name)
    flags = CONFIG_FLAGS.get(name)
    if not flags:
        return words
    out, rest = words[:i + 1], iter(words[i + 1:])
    for w in rest:
        if w == "--":
            out += [w, *rest]
        elif w in flags:
            next(rest, None)
        elif not (w.startswith("--") and "=" in w and w.split("=", 1)[0] in flags):
            out.append(w)
    return out

def lift(cmd, i, texts, subs, inner):
    # Reads cmd from i to its end, or, when inner, to the ) that closes a $(.
    # Each heredoc's text and each $( )'s command go into texts under a
    # placeholder: a heredoc becomes a read from its placeholder, and a $( )
    # its placeholder word, its command also kept in subs to be judged as
    # pipelines of its own. Returns the text and the index after it, or None
    # when the hook cannot tell where one ends or reads none of it: a
    # backtick, a process substitution, an arithmetic $(( )).
    out, q, depth, docs, n = [], None, 0, [], len(cmd)

    def put(kind, text):
        key = "__%s%d__" % (kind, len(texts))
        texts[key] = text
        return key

    while i < n:
        c = cmd[i]
        if q == "'":
            q = None if c == "'" else q
        elif c == "\\":
            out.append(cmd[i:i + 2])
            i += 2
            continue
        elif cmd.startswith("$(", i):
            got = None if cmd.startswith("$((", i) else lift(cmd, i + 2, texts, subs, True)
            if got is None:
                return None
            text, i = got
            subs.append(text)
            out.append(put("SUB", text))
            continue
        elif c == "`":
            return None
        elif q == '"':
            q = None if c == '"' else q
        elif c in "'\"":
            q = c
        elif cmd.startswith(("<(", ">("), i):
            return None
        elif c == "#" and (not out or out[-1][-1:] in " \t\n;&|()"):
            # A comment: its text stays, and a << in it opens nothing.
            j = cmd.find("\n", i)
            j = n if j < 0 else j
            out.append(cmd[i:j])
            i = j
            continue
        elif cmd.startswith("<<", i) and not cmd.startswith("<<<", i):
            m = HEREDOC.match(cmd, i)
            if not m:
                return None
            key = put("DOC", "")
            docs.append((key, m.group(2) or m.group(3) or m.group(4), m.group(1) == "-", not m.group(4)))
            out.append("< " + key)
            i = m.end()
            continue
        elif c == "\n" and docs:
            # The heredocs opened on this line take the lines after it.
            out.append(c)
            i += 1
            for key, end, tabs, quoted in docs:
                body = []
                while True:
                    if i >= n:
                        return None
                    j = cmd.find("\n", i)
                    j = n if j < 0 else j
                    line, i = cmd[i:j], j + 1
                    if (line.lstrip("\t") if tabs else line) == end:
                        break
                    body.append(line)
                texts[key] = "\n".join(body)
                # Without quotes on its end word, a heredoc runs its $( ).
                if not quoted and ("$(" in texts[key] or "`" in texts[key]):
                    return None
            docs = []
            continue
        elif c == "(":
            depth += 1
        elif c == ")":
            if depth:
                depth -= 1
            elif inner:
                return "".join(out), i + 1
        out.append(c)
        i += 1
    if docs or inner or q:
        return None
    return "".join(out), i

def pipes(cmd):
    # The pipelines of a command, each a list of parts (words, files the
    # part redirects into, files it reads by redirect). None when the hook
    # cannot read the command.
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=";&|()<>\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    # Bash starts a comment only at the start of a word; shlex at any #, and
    # drops the rest of the line, a write included.
    lex.commenters = ""
    try:
        tokens = list(lex)
    except ValueError:
        return None
    pipelines, pipe, words, outs, ins, i = [], [], [], [], [], 0
    while i < len(tokens):
        t = tokens[i]
        if t and set(t) <= set(";&|()\n"):
            pipe.append((words, outs, ins))
            words, outs, ins = [], [], []
            if not ("|" in t and "||" not in t):
                pipelines.append(pipe)
                pipe = []
        elif ">" in t and set(t) <= set("<>&|"):
            target = tokens[i + 1] if i + 1 < len(tokens) else ""
            if not (t.endswith("&") and target.isdigit()) and target != "/dev/null":
                outs.append(target)
            i += 1
        elif "<" in t and set(t) <= set("<>&"):
            ins.append(tokens[i + 1] if i + 1 < len(tokens) else "")
            i += 1
        else:
            words.append(t)
        i += 1
    pipe.append((words, outs, ins))
    pipelines.append(pipe)
    return pipelines

def cp_target(args):
    # The words of cp's arguments that it can write: its options and its
    # destination, the last path or -t's. Every word when a short option
    # cluster holds t or S, whose value the hook would have to find.
    opts, paths, dest, it, ends = [], [], None, iter(args), False
    for w in it:
        if ends or not w.startswith("-") or w == "-":
            paths.append(w)
        elif w == "--":
            ends = True
        elif w in ("--target-directory", "--suffix"):
            v = next(it, "")
            dest, opts = (v, opts) if w == "--target-directory" else (dest, [*opts, v])
        elif w.startswith("--target-directory="):
            dest = w.split("=", 1)[1]
        elif not w.startswith("--") and ("t" in w or "S" in w):
            return args
        else:
            opts.append(w)
    return [*opts, dest if dest is not None else (paths[-1] if paths else "")]

def parse(cmd):
    # The pipelines of the command and of each $( ) in it, and the texts
    # their placeholders stand for. None when the hook cannot read it.
    texts, subs = {}, []
    got = lift(cmd, 0, texts, subs, False)
    if got is None:
        return None
    pipelines = []
    for text in (got[0], *subs):
        found = pipes(text)
        if found is None:
            return None
        pipelines += found
    # The names that a function definition in the shell's text, not in a
    # heredoc's, gives: the parts lose its ().
    shell = "\n".join((got[0], *subs))
    defined = {name for m in FUNC_DEF.finditer(shell) for name in (m.group(1) or m.group(2)).split()}
    return pipelines, texts, defined, SHELL_TEXT.search(shell) is not None

def writes(path, parsed):
    # Text the hook cannot read counts whole.
    if parsed is None:
        return path in cmd
    pipelines, texts, defined, shell_text = parsed
    parts = [part for pipe in pipelines for part in pipe]
    # A guarded script that an interpreter runs is read, not written, unless
    # a part of the command changes the shell. Its arguments still count.
    scripts = not (defined & TRUSTED) and not shell_text and not any(changes_shell(part) for part in parts)
    # A word names the path where the path stands whole in it.
    whole = r"(?<![\w.-])" + re.escape(path) + ("" if path.endswith("/") else r"(?![\w.-])")
    pat = re.compile(whole)

    def names(w):
        # A placeholder names the path when its text does.
        return bool(pat.search(w)) or any(names(texts.get(k, "")) for k in re.findall(r"__(?:DOC|SUB)\d+__", w))

    def named(part):
        words, outs, ins = part
        pre, command = split(words)
        own = command if defined & set(command) else unread(command, scripts)
        return any(names(w) for w in pre + own + outs + ins)

    def inline_reads(command):
        # Each mention of the path in the script is the argument of a read call.
        flags = INLINE.get(os.path.basename(command[0]) if command else "")
        if not flags:
            return False
        script, rest, args = None, [], iter(command[1:])
        for w in args:
            if script is None and w in flags:
                script = next(args, "")
            else:
                rest.append(w)
        if script is None or "$" in script or any(names(w) for w in rest):
            return False
        spans = [m.span() for m in re.finditer(READ_CALL.format(whole), script)]
        hits = [m.start() for m in pat.finditer(script)]
        return bool(hits) and all(any(a <= h < b for a, b in spans) for h in hits)

    def reading(part):
        # A function of the command's name runs its body instead.
        command = split(part[0])[1]
        return not (command[:1] and command[0] in defined) and (reads(command) or inline_reads(command))

    # A cd into a guarded directory, or a variable bound to text that names
    # the path, carries the path from one pipeline into the next: then the
    # whole command must read, with no redirect into a file.
    anywhere = any(named(part) for part in parts)
    carried = path.endswith("/") and re.search(r"\bcd\s+[\"']?(\./)?" + re.escape(path.rstrip("/")) + r"(/|[\"'\s;&|)]|$)", cmd)
    for words, _, _ in parts:
        pre, command = split(words)
        carried = carried or any(names(w.partition("=")[2]) for w in pre if "=" in w) \
            or (command[:1] in (["for"], ["select"]) and any(names(w) for w in command[3:])) \
            or (anywhere and command[:1] and (command[0] in READERS or command[0] == "printf" and "-v" in command))
    if carried:
        return not all(reading(part) and not part[1] for part in parts)
    # A pipe carries data only forward: the part that first names the path
    # and every part after it must read, with no redirect into the path.
    def pipe_writes(pipe):
        first = next((k for k, part in enumerate(pipe) if named(part)), None)
        return first is not None and not all(reading(part) and not any(names(t) for t in part[1])
                                             for part in pipe[first:])
    return any(pipe_writes(pipe) for pipe in pipelines)

def rule_paths(decision):
    return [r[6:-1].removesuffix("**") for r in perms.get(decision, []) if r.startswith("Edit(/") and r.endswith(")")]

# The user's approval: a whole reply that is a plain yes, and nothing more.
YES = re.compile(r"\W*(?:yes|y|yep|yeah|sure|approve|approved|ok|okay|go|go on|go ahead|do it|lgtm)"
                 r"(?:\W+(?:go ahead|go on|do it|please))?\W*", re.I)
# The agent's request, in words the refusal fixes, at the start of a line
# (not quoted inside a summary): the file it names.
ASKED = re.compile(r"(?m)^\W*Approve a change to [`'\"]?([^\s`'\"?]+)")

def text_of(row):
    content = (row.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list) and all(isinstance(b, dict) and b.get("type") == "text" for b in content):
        return "\n".join(b.get("text", "") for b in content)
    return None

def asked(text):
    # The paths a text asks to change, relative to the project.
    out = set()
    for name in ASKED.findall(text or ""):
        name = name.rstrip(".,;:")
        out.add(os.path.relpath(name, root) if os.path.isabs(name) else name.removeprefix("./"))
    return out

def approvals():
    # The paths the user approved a change to in this turn: an
    # AskUserQuestion that asks for it, answered Approve or a plain yes, or
    # a prompt the user typed (not another session's message, nor one a
    # program sent with claude -p) that is a plain yes to an agent message
    # that asks for it. A question or a message asks for a change only in
    # the refusal's words.
    transcript, turn = data.get("transcript_path"), data.get("prompt_id")
    if not transcript or not turn:
        return set()
    try:
        with open(transcript) as fh:
            rows = [json.loads(line) for line in fh if line.strip()]
    except (OSError, ValueError):
        return set()
    said, ok = "", set()
    for row in rows:
        result = row.get("toolUseResult")
        answers = result.get("answers") if isinstance(result, dict) else None
        if row.get("promptId") == turn and isinstance(answers, dict):
            for q, a in answers.items():
                if a == "Approve" or YES.fullmatch(str(a)):
                    ok |= asked(q)
        if row.get("type") == "assistant":
            text = "\n".join(b.get("text", "") for b in (row.get("message") or {}).get("content") or []
                             if isinstance(b, dict) and b.get("type") == "text")
            said = text or said
        elif row.get("type") == "user" and row.get("promptId") == turn and (row.get("origin") or {}).get("kind") == "human" \
                and text_of(row) is not None and YES.fullmatch(text_of(row).strip()):
            ok |= asked(said)
    return ok

def refuse(path, locked, name):
    reason = (path + " is locked: no agent changes it. " if locked else
              path + " is guarded: it judges the work, so the user approves each change to it. Do not try "
              "another way. If the change is needed, ask the user first: start with \"Approve a change to " +
              name + "?\", then say in one or two plain sentences what changes in it and why the work needs "
              "it, and leave the command out. With AskUserQuestion, put all that in the question and give the "
              "options Approve and Deny; without it, ask in your reply and end your turn. Once the user "
              "approves, make the change. ") + \
        "To only read it, use cat, jq or git show, or run the tool without naming the file."
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    sys.exit(0)

locked = rule_paths("deny")
# An older guard listed its paths as ask rules.
guarded = listed + [path for path in rule_paths("ask") if path not in listed]
rel = ""
if tool == "Bash":
    parsed = parse(cmd)
    hit = lambda path: writes(path, parsed)
else:
    target = data.get("tool_input", {}).get("file_path") or data.get("tool_input", {}).get("notebook_path") or ""
    rel = os.path.relpath(os.path.abspath(os.path.join(root, target)), root) if target else ""
    hit = lambda path: bool(rel) and (rel.startswith(path) if path.endswith("/") else rel == path)
def approved(path):
    # An approval names what changes: the file an edit tool changes; for a
    # shell write, the guarded path, or each file in a guarded folder that
    # the command names.
    ok = approvals()
    if tool != "Bash":
        return rel in ok
    if path in ok or not path.endswith("/"):
        return path in ok
    named = {m.rstrip(".,;:") for m in re.findall(r"(?<![\w./-])" + re.escape(path) + r"[^\s'\"`;|&<>()]*", cmd)}
    return bool(named) and named <= ok

for path in locked:
    if path and hit(path):
        refuse(path, True, path)
for path in guarded:
    if path and hit(path) and not approved(path):
        refuse(path, False, rel if tool != "Bash" else path)
PY
)"
